//modified version of [this shader](https://github.com/wessles/GLSL-CRT/blob/master/shader.frag)
precision highp float;
varying vec2 v_texcoord;
uniform sampler2D tex;

void main() {
	vec2 tc = vec2(v_texcoord.x, v_texcoord.y);
	
	// Distance from the center
	float dx = abs(0.5-tc.x);
	float dy = abs(0.5-tc.y);
	
	// Square it to smooth the edges (more distortion for that shitty CRT look)
	dx *= dx;
	dy *= dy;
	
	// Increased barrel distortion for that warped CRT effect
	tc.x -= 0.5;
	tc.x *= 1.0 + (dy * 0.08);
	tc.x += 0.5;
	tc.y -= 0.5;
	tc.y *= 1.0 + (dx * 0.08);
	tc.y += 0.5;
	
	// Get texel with reduced chromatic aberration (nvidia friendly)
	vec2 red_offset = vec2(0.0004, 0.0);
	vec2 blue_offset = vec2(-0.0004, 0.0);
	
	float r = texture2D(tex, tc + red_offset).r;
	float g = texture2D(tex, tc).g;
	float b = texture2D(tex, tc + blue_offset).b;
	vec4 cta = vec4(r, g, b, 1.0);
	
	// Orange tint for that old phosphor look (subtle hint)
	vec3 orange_tint = vec3(1.05, 1.0, 0.92);
	cta.rgb *= orange_tint;
	
	// Brighten it up a bit
	cta.rgb *= 1.20;
	
	// CRT pixel grid simulation (RGB sub-pixels)
	vec2 pixel_pos = tc * vec2(1920.0, 1080.0); // adjust for your resolution
	vec2 pixel_grid = fract(pixel_pos);
	
	// RGB sub-pixel mask
	float mask = 1.0;
	if (mod(pixel_pos.x, 3.0) < 1.0) {
		cta.g *= 0.8;
		cta.b *= 0.8;
	} else if (mod(pixel_pos.x, 3.0) < 2.0) {
		cta.r *= 0.8;
		cta.b *= 0.8;
	} else {
		cta.r *= 0.8;
		cta.g *= 0.8;
	}
	
	// Anti-aliasing simulation (soften pixels)
	vec2 aa_offset = vec2(0.0003, 0.0003);
	vec4 aa1 = texture2D(tex, tc + aa_offset);
	vec4 aa2 = texture2D(tex, tc - aa_offset);
	cta.rgb = mix(cta.rgb, (aa1.rgb + aa2.rgb) * 0.5, 0.3);
	
	// Classic CRT scanlines - the way phosphor creates horizontal lines
	float scanline_intensity = sin(tc.y * 1200.0) * 0.04;
	
	// Simulate the phosphor decay creating the scanline effect
	float phosphor_glow = 1.0 + sin(tc.y * 600.0) * 0.02;
	cta.rgb *= phosphor_glow;
	
	// Add the horizontal line effect
	cta.rgb += scanline_intensity;
	
	// Classic interlacing effect - scanlines moving upward slowly
	// Using a time simulation based on screen coordinates
	float interlace_time = tc.x * 3.14159; // simulate frame timing
	float interlace_field = step(0.5, fract((tc.y * 600.0) + interlace_time * 0.1));
	cta.rgb *= 0.95 + interlace_field * 0.2;
	
	// Very subtle bloom
	vec2 blur_offset = vec2(0.0004, 0.0);
	vec4 blur1 = texture2D(tex, tc + blur_offset);
	vec4 blur2 = texture2D(tex, tc - blur_offset);
	vec3 blurred = (blur1.rgb + blur2.rgb) * orange_tint;
	cta.rgb += blurred * 0.08;
	
	// Add phosphor glow/bloom
	float glow = 1.0 + dot(cta.rgb, vec3(0.299, 0.587, 0.114)) * 0.8;
	cta.rgb *= glow;
	
	// Vignette effect (darker edges)
	float vignette = 1.0 - (dx + dy) * 1.2;
	vignette = clamp(vignette, 0.3, 1.0);
	cta.rgb *= vignette;
	
	// Add some noise for that authentic shitty CRT experience
	float noise = (fract(sin(dot(tc.xy, vec2(12.9898, 78.233))) * 43758.5453) - 0.5) * 0.04;
	cta.rgb += noise;
	
	// Increase contrast and saturation
	cta.rgb = (cta.rgb - 0.5) * 1.10 + 0.5;
	
	// Cutoff (black bars outside screen area)
	if(tc.y > 1.0 || tc.x < 0.0 || tc.x > 1.0 || tc.y < 0.0)
		cta = vec4(0.0);
	
	// Apply
	gl_FragColor = cta;
}
